/**
 * This ruleset enforces a strict user-ownership model for the SafeStart Invest platform.
 * It ensures that all sensitive user data, such as profiles and investment portfolios,
 * is completely private and accessible only to the authenticated owner.
 *
 * Core Philosophy:
 * The security model is built on a "user data sandbox" principle. All data belonging
 * to a user is nested within a `/users/{userId}` document tree. Access is controlled
 * primarily by matching the authenticated user's ID (`request.auth.uid`) with the
 * `{userId}` wildcard in the path, which is a highly secure and performant pattern.
 * Publicly accessible content, like educational materials and blog articles, is
 * stored in separate top-level collections, ensuring a clear segregation between
 * private and public data.
 *
 * Data Structure:
 * - /users/{userId}/userProfiles/{profileId} -> Private user profile data.
 * - /users/{userId}/investmentPortfolios/{portfolioId} -> Private user investment portfolios.
 * - /users/{userId}/investmentPortfolios/{portfolioId}/nextStepRecommendations/{recommendationId} -> Private, AI-generated recommendations for a specific portfolio.
 * - /users/{userId}/trilha/progress -> Private user progress data for the educational trail.
 * - /users/{userId}/dailyNewsCache/{cacheId} -> Private, user-specific cache for daily news.
 * - /educationalTrails/{trailId} -> Public, read-only educational content.
 * - /blogArticles/{articleId} -> Public, read-only blog content.
 *
 * Key Security Decisions:
 * - User Isolation: A user can ONLY read or write data within their own `/users/{userId}` path.
 * - No User Listing: It is impossible for any client to list all users in the system.
 * - Public Read-Only Content: Educational trails and blog articles are publicly readable by anyone but cannot be modified by any client. This assumes content is managed via a trusted server-side Admin SDK.
 * - Relational Integrity: On creation, documents within a user's path (e.g., a portfolio) MUST contain a field that correctly references the parent (e.g., a `userId` field). This field is then made immutable on update to prevent re-association.
 * - Flexible Schema: While authorization is strict, the rules do not validate the specific shape or data types of most fields, allowing for rapid front-end development and prototyping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently signed-in user is the owner of the resource
     * identified by the given userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the signed-in user is the owner of an EXISTING document.
     * Crucial for secure update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates that the UserProfile being created has an 'id' field
     * that matches the user's auth UID in the path.
     */
    function hasValidUserProfileDataOnCreate(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * Enforces immutability of the UserProfile's 'id' field on update,
     * correctly handling partial updates.
     */
    function hasValidUserProfileDataOnUpdate() {
      return !('id' in request.resource.data) || request.resource.data.id == resource.data.id;
    }

    /**
     * Validates that the InvestmentPortfolio being created has a 'userId'
     * field that matches the user's auth UID in the path.
     */
    function hasValidPortfolioDataOnCreate(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Enforces immutability of the InvestmentPortfolio's 'userId' field on update.
     */
    function hasValidPortfolioDataOnUpdate() {
      return request.resource.data.userId == resource.data.userId;
    }

    /**
     * Validates that the Recommendation being created has a 'portfolioId'
     * field that matches the portfolioId in the path.
     */
    function hasValidRecommendationDataOnCreate(portfolioId) {
      return request.resource.data.portfolioId == portfolioId;
    }
    
    /**
     * Enforces immutability of the Recommendation's 'portfolioId' field on update.
     */
    function hasValidRecommendationDataOnUpdate() {
      return request.resource.data.portfolioId == resource.data.portfolioId;
    }
    
    /**
     * Ensures the UserProgress document has the correct structure on create.
     * Fields like xp, coins, and streakDays must start at 0.
     */
    function hasValidUserProgressDataOnCreate() {
      let data = request.resource.data;
      return data.xp == 0 &&
             data.coins == 0 &&
             data.streakDays == 0 &&
             data.lastStudyDate == null &&
             data.completedLessons.size() == 0 &&
             data.earnedBadges.size() == 0;
    }

    /**
     * Ensures fields that should be incremented (like xp, coins, streakDays)
     * only increase or stay the same, preventing cheating.
     */
    function hasValidUserProgressDataOnUpdate() {
        let newData = request.resource.data;
        let oldData = resource.data;
        return newData.xp >= oldData.xp &&
               newData.coins >= oldData.coins &&
               newData.streakDays >= oldData.streakDays;
    }


    // --------------------------------------------------------------------
    // User Data Rules
    // --------------------------------------------------------------------

    /**
     * @description Denies any client from listing all users.
     * @path /users
     * @allow N/A
     * @deny A logged-in user attempts to list documents in the `/users` collection.
     * @principle Prevents data leakage by disallowing enumeration of all platform users.
     */
    match /users/{userId} {
      allow read, write: if false;

      /**
       * @description Secures a user's private profile. Only the owner can manage their profile.
       * @path /users/{userId}/userProfiles/{profileId}
       * @allow (create) A new user (auth.uid=`user_abc`) creates their own profile at `/users/user_abc/userProfiles/profile_123`.
       * @deny (get) A user (auth.uid=`user_xyz`) tries to read a profile at `/users/user_abc/userProfiles/profile_123`.
       * @principle Restricts access to a user's own data tree.
       */
      match /userProfiles/{profileId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUserProfileDataOnCreate(userId);
        allow update: if isOwner(userId)
                    && hasValidUserProfileDataOnUpdate()
                    && (!('accountType' in request.resource.data) || request.resource.data.accountType == resource.data.accountType)
                    && (
                      !('plan' in request.resource.data) ||
                      request.resource.data.plan == resource.data.plan ||
                      (resource.data.plan == 'starter' && request.resource.data.plan == 'pro')
                    );
        allow delete: if isExistingOwner(userId);
      }
      
       /**
       * @description Secures a user's progress in the educational trail. Only the owner can read/write their progress.
       * @path /users/{userId}/trilha/{docId}
       * @allow (get) A user (auth.uid=`user_abc`) reads their progress at `/users/user_abc/trilha/progress`.
       * @deny (list) A user tries to list documents in the `trilha` subcollection.
       * @principle Enforces strict ownership for gamified progress data.
       */
      match /trilha/{docId} {
          // Only allow access to the specific 'progress' document
          allow get: if isOwner(userId) && docId == 'progress';
          allow create: if isOwner(userId) && docId == 'progress' && hasValidUserProgressDataOnCreate();
          allow update: if isExistingOwner(userId) && docId == 'progress' && hasValidUserProgressDataOnUpdate();
          // Generally, progress should not be deleted by the user.
          allow delete: if false; 
          allow list: if false;
      }

      /**
       * @description Secures a user's investment portfolios. Only the owner can view or modify them.
       * @path /users/{userId}/investmentPortfolios/{portfolioId}
       * @allow (list) A logged-in user (auth.uid=`user_abc`) lists their own portfolios at `/users/user_abc/investmentPortfolios`.
       * @deny (update) A user (auth.uid=`user_xyz`) tries to modify a portfolio at `/users/user_abc/investmentPortfolios/port_456`.
       * @principle Enforces document ownership and validates relational integrity between a portfolio and its owner.
       */
      match /investmentPortfolios/{portfolioId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidPortfolioDataOnCreate(userId);
        allow update: if isExistingOwner(userId) && hasValidPortfolioDataOnUpdate();
        allow delete: if isExistingOwner(userId);

        /**
         * @description Secures AI-generated recommendations for a portfolio. Access is inherited from the parent portfolio owner.
         * @path /users/{userId}/investmentPortfolios/{portfolioId}/nextStepRecommendations/{recommendationId}
         * @allow (get) The portfolio owner (auth.uid=`user_abc`) reads a recommendation at `/users/user_abc/investmentPortfolios/port_456/nextStepRecommendations/rec_789`.
         * @deny (create) A different user (auth.uid=`user_xyz`) tries to create a recommendation under another user's portfolio.
         * @principle Inherits ownership from the parent document path, ensuring data privacy in nested subcollections.
         */
        match /nextStepRecommendations/{recommendationId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && hasValidRecommendationDataOnCreate(portfolioId);
          allow update: if isExistingOwner(userId) && hasValidRecommendationDataOnUpdate();
          allow delete: if isExistingOwner(userId);
        }
      }

      /**
       * @description Secures the user-specific cache for daily news. Only the owner can manage their cache.
       * @path /users/{userId}/dailyNewsCache/{date}
       * @allow (get) A user reads their own cached news for a specific date.
       * @deny (list) A user cannot list all cached news entries.
       * @principle Restricts access to a user's own data tree for temporary/cached data.
       */
      match /dailyNewsCache/{cacheId} {
        allow read, write: if isOwner(userId);
        allow list: if false; // Don't allow listing cache entries
      }
    }

    // --------------------------------------------------------------------
    // Public Content Rules
    // --------------------------------------------------------------------

    /**
     * @description Allows public, read-only access to all educational trails.
     * @path /educationalTrails/{educationalTrailId}
     * @allow (get) Any user, including unauthenticated ones, can read an educational trail.
     * @deny (create, update, delete) No client, authenticated or not, can modify the educational content.
     * @principle Segregates public data into a read-only collection, assuming content is managed by a trusted backend.
     */
    match /educationalTrails/{educationalTrailId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public, read-only access to all blog articles.
     * @path /blogArticles/{blogArticleId}
     * @allow (list) Any user, including unauthenticated ones, can list all blog articles.
     * @deny (create, update, delete) No client, authenticated or not, can write or delete blog articles.
     * @principle Provides public read access to global content while preventing all client-side modifications for security.
     */
    match /blogArticles/{blogArticleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // --------------------------------------------------------------------
    // Public CVM Data Rules
    // --------------------------------------------------------------------
    /**
     * @description Allows public, read-only access to all CVM FII reports.
     * @path /fii-reports-cvm/{reportId}
     * @allow (get, list) Any user, including unauthenticated ones, can read the reports.
     * @deny (create, update, delete) No client can modify the CVM data. This must be done via the admin sync flow.
     * @principle Provides public read access to global data while preventing all client-side modifications for security.
     */
    match /fii-reports-cvm/{reportId} {
      allow get: if true;
      allow list: if true;
      allow write: if false;
    }

    // --------------------------------------------------------------------
    // Company Data Rules (B2B)
    // --------------------------------------------------------------------
    /**
     * @description Secures B2B company data. For now, all client access is disabled.
     * @path /companies/{companyId}
     * @principle Disables all client-side access to company data until the B2B dashboard is implemented with proper server-side authorization.
     */
    match /companies/{companyId} {
      allow read, write: if false; 
      
      /**
       * @description Secures links between companies and clients.
       * @path /companies/{companyId}/clientLinks/{linkId}
       * @principle Disables all client-side access.
       */
      match /clientLinks/{linkId} {
        allow read, write: if false;
      }
    }
  }
}
